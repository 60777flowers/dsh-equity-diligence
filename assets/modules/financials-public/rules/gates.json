{
  "minEvidence": 6,
  "minCoverage": 0.8,
  "requiredFields": [
    "data.fiscalYear",
    "data.revenue",
    "data.netProfit",
    "data.recon"
  ],
  "minItems": {
    "data.recon": 3
  },
  "maxEstimatedRatio": 0.15,
  "consistency": [
    {
      "id": "reconComplete",
      "path": "data.recon",
      "rule": "all_have_status",
      "note": "每条 recon 必须有 pass/fail/insufficient，不得留空"
    },
    {
      "id": "grossMarginRange",
      "path": "data.grossMargin",
      "rule": "in_range",
      "min": -1,
      "max": 1,
      "note": "毛利率为 0–1 小数；负值表示毛损"
    }
  ]
}
