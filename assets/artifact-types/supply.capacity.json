        "singleSource": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "item": {
                "type": "string"
              },
              "supplier": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "capacity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "product": {
                "type": "string"
              },
              "designCapacity": {
                "type": "string"
              },
              "effectiveCapacity": {
                "type": "string"
              },
              "output": {
                "type": "string"
              },
              "utilization": {
                "type": "number"
              },
              "period": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "costStructure": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "item": {
                "type": "string"
              },
              "pct": {
                "type": "number"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    }
