{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asOf",
    "openQuestions",
    "flags",
    "sourceCoverage",
    "claims",
    "evidence",
    "data"
  ],
  "properties": {
    "asOf": {
      "type": "string",
      "format": "date",
      "description": "数据截至日"
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "question": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "priority": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            },
            "required": [
              "question"
            ]
          }
        ]
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "level",
          "desc"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "attention",
              "material"
            ]
          },
          "rule": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "triggerId": {
            "type": "string"
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string"
          },
          "materiality": {
            "type": "string",
            "enum": [
              "material",
              "attention",
              "context"
            ]
          }
        }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "query": {
                "type": "string"
              },
              "engine": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "resultCount": {
                "type": "number"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retrievedAt": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "claimId",
          "predicate",
          "status"
        ],
        "properties": {
          "claimId": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "period": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "asOf": {
                "type": "string"
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "found",
              "not_disclosed_after_search",
              "lower_bound",
              "pending_dd",
              "conflict",
              "not_applicable",
              "not_reviewed",
              "estimated"
            ]
          },
          "materiality": {
            "type": "string",
            "enum": [
              "material",
              "attention",
              "context"
            ]
          },
          "evidenceLinks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "evidenceId": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "supports",
                    "contradicts",
                    "contextual"
                  ]
                },
                "locator": {
                  "type": "string"
                },
                "rawHash": {
                  "type": "string"
                }
              },
              "required": [
                "evidenceId",
                "role"
