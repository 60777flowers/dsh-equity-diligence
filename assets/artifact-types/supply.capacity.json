          },
          "derivation": {
            "type": "object",
            "additionalProperties": true
          },
          "conflictGroup": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "chosenClaimId": {
                "type": "string"
              },
              "resolutionRationale": {
                "type": "string"
              },
              "decidedBy": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "evidenceId",
          "sourceTier",
          "verificationStatus"
        ],
        "properties": {
          "evidenceId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "finalUrl": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "sourceTier": {
            "type": "string",
            "enum": [
              "announcement",
              "registry",
              "regulator",
              "court",
              "exchange",
              "company",
              "media",
              "database",
              "import",
              "sample",
              "case_reference"
            ]
          },
          "sourceAuthority": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "sourceIndependence": {
            "type": "string",
            "enum": [
              "independent",
              "same_origin",
              "self_reported",
              "unknown"
            ]
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "verified",
              "partial",
              "unreachable",
              "unverified"
            ]
          },
          "claimConfidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "asOf": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string"
          },
          "rawHash": {
            "type": "string"
          },
          "originGroupId": {
            "type": "string"
          },
          "verification": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "quote-exact",
                  "manual",
                  "import",
                  "provider"
                ]
              },
              "checkedAt": {
                "type": "string"
              },
              "matches": {
                "type": "boolean"
              }
            }
          },
          "snapshotPath": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
